#!/usr/bin/env bash
# Deprecated: renamed to scripts/omega. Kept for one release so existing
# invocations keep working.

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"

if [ -n "${here}" ] && [ -f "${here}/omega" ]; then
    echo "scripts/omegaclaw is deprecated, use scripts/omega instead" >&2
    exec "${here}/omega" "$@"
fi

echo "scripts/omegaclaw has been renamed to scripts/omega." >&2
echo "Fetch it from https://github.com/singnet/Omega/raw/refs/heads/main/scripts/omega" >&2
exit 1
