#!/usr/bin/env bash
# Push the nine CI/CD secrets to the bot repository from a filled .env.cicd.
#
# They are repository secrets, not environment ones. Staging and production
# authenticate to Infisical as different machine identities, so their
# credentials get distinct names and each deploy workflow passes the pair it
# needs into the shared deploy job.
#
# No value is printed. The eight single-line secrets go through a 0600 temp
# file that is shredded on exit; SSH_PRIVATE_KEY is streamed from its key file
# so the newlines survive.
set -euo pipefail

SRC="${1:-.env.cicd}"
REPO="${2:-singnet/Omega_CustomBots}"
DRY="${DRY:-0}"

[ -f "$SRC" ] || { echo "no $SRC" >&2; exit 1; }

read_key() { sed -n "s/^$1=//p" "$SRC" | tail -1; }

# The environment's own value, falling back to the shared one.
value_for() {
    local prefix="$1" name="$2" v
    v="$(read_key "${prefix}_${name}")"
    [ -n "$v" ] || v="$(read_key "$name")"
    printf '%s' "$v"
}

expand() { printf '%s' "${1/#\~/$HOME}"; }

problems=()
need() { [ -n "$2" ] || problems+=("$1 is empty"); }

SLUG="$(value_for STAGING INFISICAL_PROJECT_SLUG)"
STG_ID="$(value_for STAGING INFISICAL_CLIENT_ID)"
STG_SECRET="$(value_for STAGING INFISICAL_CLIENT_SECRET)"
STG_HOST="$(value_for STAGING SSH_HOST)"
PRD_ID="$(value_for PRODUCTION INFISICAL_CLIENT_ID)"
PRD_SECRET="$(value_for PRODUCTION INFISICAL_CLIENT_SECRET)"
PRD_HOST="$(value_for PRODUCTION SSH_HOST)"

need INFISICAL_PROJECT_SLUG "$SLUG"
need STAGING_INFISICAL_CLIENT_ID "$STG_ID"
need STAGING_INFISICAL_CLIENT_SECRET "$STG_SECRET"
need STAGING_SSH_HOST "$STG_HOST"
need PRODUCTION_INFISICAL_CLIENT_ID "$PRD_ID"
need PRODUCTION_INFISICAL_CLIENT_SECRET "$PRD_SECRET"
need PRODUCTION_SSH_HOST "$PRD_HOST"

# The workflows share one SSH_USER and one SSH_PRIVATE_KEY across both
# deployments, so the two environments have to agree on them. If they ever
# stop agreeing, these need splitting the way the hosts are.
USER_STG="$(value_for STAGING SSH_USER)"; USER_PRD="$(value_for PRODUCTION SSH_USER)"
KEY_STG="$(expand "$(value_for STAGING SSH_KEY_FILE)")"
KEY_PRD="$(expand "$(value_for PRODUCTION SSH_KEY_FILE)")"
need SSH_USER "$USER_STG"
need SSH_KEY_FILE "$KEY_STG"
[ "$USER_STG" = "$USER_PRD" ] || problems+=("staging and production disagree on SSH_USER; the workflows share one")
[ "$KEY_STG" = "$KEY_PRD" ] || problems+=("staging and production disagree on SSH_KEY_FILE; the workflows share one")

if [ -n "$KEY_STG" ]; then
    [ -f "$KEY_STG" ] || problems+=("SSH_KEY_FILE points at $KEY_STG, which is not a file")
    if [ -f "$KEY_STG" ] && ! grep -q 'PRIVATE KEY' "$KEY_STG"; then
        problems+=("$KEY_STG does not look like a private key")
    fi
fi
[ "$STG_HOST" != "$PRD_HOST" ] || problems+=("staging and production point at the same host; check they are not swapped")

if [ "${#problems[@]}" -gt 0 ]; then
    printf 'not ready:\n' >&2; printf '  %s\n' "${problems[@]}" >&2; exit 1
fi

TMP="$(mktemp)"; chmod 600 "$TMP"
trap 'shred -u "$TMP" 2>/dev/null || rm -f "$TMP"' EXIT
{
    printf 'INFISICAL_PROJECT_SLUG=%s\n'             "$SLUG"
    printf 'INFISICAL_CLIENT_ID_STAGING=%s\n'        "$STG_ID"
    printf 'INFISICAL_CLIENT_SECRET_STAGING=%s\n'    "$STG_SECRET"
    printf 'SSH_HOST_STAGING=%s\n'                   "$STG_HOST"
    printf 'INFISICAL_CLIENT_ID_PRODUCTION=%s\n'     "$PRD_ID"
    printf 'INFISICAL_CLIENT_SECRET_PRODUCTION=%s\n' "$PRD_SECRET"
    printf 'SSH_HOST_PRODUCTION=%s\n'                "$PRD_HOST"
    printf 'SSH_USER=%s\n'                           "$USER_STG"
} > "$TMP"

echo "target: $REPO"
echo "  staging    -> $STG_HOST"
echo "  production -> $PRD_HOST"
echo "  ssh        -> $USER_STG using $KEY_STG"
if [ "$DRY" = 1 ]; then
    echo "DRY RUN, nothing sent. would set 9 repository secrets:"
    cut -d= -f1 "$TMP" | sed 's/^/  /'
    echo "  SSH_PRIVATE_KEY  (streamed from $KEY_STG)"
    exit 0
fi
gh secret set -f "$TMP" -R "$REPO"
gh secret set SSH_PRIVATE_KEY -R "$REPO" < "$KEY_STG"
echo
echo "now on $REPO:"
gh secret list -R "$REPO" | sed 's/^/  /'
